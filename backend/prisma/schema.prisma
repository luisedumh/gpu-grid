// Prisma schema: the single source of truth for the database structure.
// After changing it: `npm run db:migrate` (creates a migration) and `npm run db:generate`.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Lifecycle of a job, from upload to final result.
enum JobStatus {
  PENDING        // received, waiting to be compiled
  COMPILING      // nvcc is running
  COMPILE_FAILED // nvcc reported errors (final)
  QUEUED         // compiled, waiting for a free GPU
  RUNNING        // executing on a provider's GPU
  COMPLETED      // finished with exit code 0 (final)
  FAILED         // non-zero exit code or execution error (final)
  TIMED_OUT      // killed after exceeding its time limit (final)
}

/// What a job runs: a CUDA program compiled by us, or a Docker image of the client.
enum JobKind {
  CUDA   // source code compiled with nvcc (one file or a project)
  DOCKER // image given by name or uploaded as a .tar; it is not compiled
}

/// A job submitted by a client (CUDA program or Docker image), and everything that happened to it.
model Job {
  id             String    @id @default(uuid())
  name           String
  kind           JobKind   @default(CUDA)
  /// CUDA: the code (main file of a project). Empty for Docker jobs.
  sourceCode     String
  /// Projects of several files: [{ path, content }]. Null for single-file jobs (only sourceCode).
  files          Json?

  // Docker jobs
  /// Image published in a registry, e.g. nvidia/cuda:13.0.1-base-ubuntu24.04
  image            String?
  /// Original name of the uploaded .tar (the client sees it)
  imageArchiveName String?
  /// Where the uploaded .tar is stored on the server (private)
  archivePath      String?
  /// Command run inside the container; null runs the image's default one
  command          String?

  status         JobStatus @default(PENDING)
  timeoutSeconds Int       @default(60)

  // Owner: the client who submitted it (if the account is deleted, so are its jobs)
  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  // Compilation
  compilerOutput String?
  binaryPath     String?

  // Execution
  attempts   Int     @default(0)
  stdout     String?
  stderr     String?
  exitCode   Int?
  durationMs Int?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status])
  @@index([createdAt])
  @@index([clientId, createdAt])
}

/// Kinds of account. Administrators cannot sign up from the web.
enum Role {
  CLIENT   // submits jobs
  PROVIDER // offers GPU machines
  ADMIN    // sees and manages everything
}

/// A person with an account on the platform.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CLIENT)
  createdAt    DateTime @default(now())

  /// Jobs this user has submitted
  jobs Job[]
}
