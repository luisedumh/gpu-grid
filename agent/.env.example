# Base URL of the GPU Grid backend
SERVER_URL="http://localhost:3000"
# Must match AGENT_TOKEN in backend/.env
AGENT_TOKEN="change-me-to-a-long-random-string"
# Name shown for this machine (defaults to the hostname)
# AGENT_NAME="my-gpu-server"
# Simulation mode: pretend to run the jobs, for machines without a GPU (CI, demos)
# AGENT_SIMULATE=1
# Docker image jobs: largest image accepted and longest download time
# MAX_IMAGE_GB=10
# PULL_TIMEOUT_SECONDS=600
